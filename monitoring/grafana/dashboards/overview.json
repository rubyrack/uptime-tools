{
  "uid": "uptime-overview",
  "title": "Uptime - Control room",
  "description": "The whole provider on one screen. Money, headroom, traffic and open incidents. Shaded bands mark the periods when an incident was open or an attack was inbound.",
  "tags": ["uptime"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["uptime"],
      "targetBlank": false,
      "title": "Uptime",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "uptime-prom" },
        "enable": true,
        "expr": "uptime_incidents_open > 0",
        "hide": false,
        "iconColor": "red",
        "name": "Incident open",
        "step": "10s",
        "textFormat": "{{value}} open",
        "titleFormat": "Incident"
      },
      {
        "datasource": { "type": "prometheus", "uid": "uptime-prom" },
        "enable": true,
        "expr": "uptime_active_ddos_gbps > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Under attack",
        "step": "10s",
        "textFormat": "{{value}} Gbps inbound",
        "titleFormat": "Attack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cash",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "currencyUSD",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_cash_dollars",
          "legendFormat": "Cash",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reputation",
      "description": "The engine carries this as a 0 to 1 ratio, so the panel shows it as a percentage rather than a score out of a hundred.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.4 },
              { "color": "green", "value": 0.65 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_reputation",
          "legendFormat": "Reputation",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Customers served",
      "description": "Customers the engine is serving right now. Any shortfall against the contract count is a customer whose traffic is not getting through.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_customers_active",
          "legendFormat": "Served",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Hosts online",
      "description": "Powered, up, and reachable through a live network chain to a carrier line. Racked hardware that is not online earns nothing, and the Capacity dashboard shows the gap.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "super-light-blue" },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_hosts_online",
          "legendFormat": "Online",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Open incidents",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_incidents_open",
          "legendFormat": "Incidents",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Work orders",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_work_orders_open",
          "legendFormat": "Work orders",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Simulated time",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "unit": "s",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_sim_time_seconds",
          "legendFormat": "Sim time",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Site",
      "description": "Read out of the uptime_build_info labels. That series always has the value 1, and its labels carry the site id and name.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "super-light-blue" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^site_name$/", "values": false },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_build_info",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Capacity headroom",
      "description": "How much of each limit is in use. Uplink divides by the EFFECTIVE ceiling the simulation enforces rather than the nameplate the circuits are billed at. The Internet dashboard shows the difference and names the binding term.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "sizing": "auto",
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "100 * uptime_uplink_egress_gbps / clamp_min(uptime_wan_effective_gbps, 0.001)",
          "legendFormat": "Uplink",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "100 * uptime_heat_load_watts / clamp_min(uptime_cooling_capacity_watts, 1)",
          "legendFormat": "Cooling",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "100 * uptime_fleet_mem_ratio",
          "legendFormat": "Memory",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "100 * uptime_fleet_disk_ratio",
          "legendFormat": "Disk",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "100 * uptime_public_ips_used / clamp_min(uptime_public_ips_max, 1)",
          "legendFormat": "Public IPs",
          "range": true,
          "refId": "E"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Uplink traffic",
      "description": "Egress against the ceiling the simulation actually enforces, with inbound attack volume on the same axis so you can see what is customer traffic and what is not.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "bps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Egress" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Effective ceiling" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Inbound attack" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 45 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_uplink_egress_gbps * 1e9",
          "legendFormat": "Egress",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_wan_effective_gbps * 1e9",
          "legendFormat": "Effective ceiling",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_active_ddos_gbps * 1e9",
          "legendFormat": "Inbound attack",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Revenue against operating cost",
      "description": "Both figures are cumulative for the life of the world. Operating cost EXCLUDES hardware, because a purchase converts cash into an asset and reaches the accounts as depreciation. The gap between these two lines is therefore not profit. It is wrong by what you have spent on kit.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "unit": "currencyUSD",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Revenue" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Operating cost" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Revenue less operating cost" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "super-light-blue", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 3 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_revenue_total_dollars",
          "legendFormat": "Revenue",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_cost_total_dollars",
          "legendFormat": "Operating cost",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_revenue_total_dollars - uptime_cost_total_dollars",
          "legendFormat": "Revenue less operating cost",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Booked in the last simulated hour",
      "description": "Revenue the engine booked over the last hour of game time. It rises when a contract starts and falls when a customer leaves.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 65,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "currencyUSD",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_revenue_last_hour_dollars",
          "legendFormat": "Per simulated hour",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Packet drops by stage",
      "description": "The same measurement at three points in the path, on one axis so you can compare them. Facility egress is the site's own uplink, backbone is the worst inter-zone trunk lane, and appliance fabric is what the security appliances are shedding.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
