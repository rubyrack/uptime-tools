{
  "uid": "uptime-internet",
  "title": "Uptime - Internet",
  "description": "The WAN edge. What leaves the site for the internet, the ceiling that holds it back, and which of the three terms is binding.",
  "tags": ["uptime"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["uptime"],
      "targetBlank": false,
      "title": "Uptime",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "uptime-prom" },
        "enable": true,
        "expr": "uptime_active_ddos_gbps > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Under attack",
        "step": "10s",
        "textFormat": "{{value}} Gbps inbound",
        "titleFormat": "Attack"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Egress now",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "unit": "bps",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_uplink_egress_gbps * 1e9",
          "legendFormat": "Egress",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Effective ceiling",
      "description": "The ceiling the simulation enforces: per zone, the smallest of lines, gateway fabric and inline edge appliance, summed over zones. Sustained egress above this is what causes facility egress drops.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "mappings": [],
          "unit": "bps",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_wan_effective_gbps * 1e9",
          "legendFormat": "Effective",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nameplate",
      "description": "What the circuits are rated for and billed at. It sits far above the effective ceiling more often than not. Two 100 G circuits behind two routers that cannot share a prefix bill 200 and deliver whatever the larger router forwards.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [],
          "unit": "bps",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_uplink_capacity_gbps * 1e9",
          "legendFormat": "Nameplate",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "What binds the ceiling",
      "description": "Which of the three terms is holding you back, so a low ceiling names the part to upgrade. Empty means nothing is deliverable at all.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^binding$/", "values": false },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_wan_binding_info",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Utilisation",
      "description": "Egress against the effective ceiling. Dividing by the nameplate instead reads low while the site is saturating, which is when you need the number.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "100 * uptime_uplink_egress_gbps / clamp_min(uptime_wan_effective_gbps, 0.001)",
          "legendFormat": "Utilisation",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Inbound attack",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "bps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_active_ddos_gbps * 1e9",
          "legendFormat": "Attack",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Egress against both ceilings",
      "description": "The gap between the dashed nameplate line and the solid effective line is capacity you are paying for and cannot use. Attack volume is on the same axis because it competes for the same pipe.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "bps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Egress" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Effective ceiling" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Nameplate" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "text", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "dash": [8, 6], "fill": "dash" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Inbound attack" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 45 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_uplink_egress_gbps * 1e9",
          "legendFormat": "Egress",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_wan_effective_gbps * 1e9",
          "legendFormat": "Effective ceiling",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_uplink_capacity_gbps * 1e9",
          "legendFormat": "Nameplate",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_active_ddos_gbps * 1e9",
          "legendFormat": "Inbound attack",
          "range": true,
          "refId": "D"
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "The three terms",
      "description": "The effective ceiling is the smallest of these, so the shortest bar is the part to upgrade. A term reading zero is not modelled on this site, so it is not gating.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "mappings": [],
          "unit": "bps",
          "decimals": 0,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "sizing": "auto",
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": false },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_wan_lines_gbps * 1e9",
          "legendFormat": "Lines",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_wan_gateway_fabric_gbps * 1e9",
          "legendFormat": "Gateway fabric",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_wan_inline_appliance_gbps * 1e9",
          "legendFormat": "Inline appliance",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Facility egress drops",
      "description": "The fraction of offered egress that cannot get out of the effective pipe. When this is above zero, customers are seeing failed requests while the nameplate still looks healthy.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_drop_probability{stage=\"facility_egress\"}",
          "legendFormat": "Facility egress",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Public IPs allocated",
      "description": "Allocations against the size of the block. Running out stops growth rather than causing an outage; existing customers keep working.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Allocated" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Block size" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "text", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 1 },
              { "id": "custom.lineStyle", "value": { "dash": [8, 6], "fill": "dash" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_public_ips_used",
          "legendFormat": "Allocated",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_public_ips_max",
          "legendFormat": "Block size",
          "range": true,
          "refId": "B"
        }
      ]
    }
  ]
}
