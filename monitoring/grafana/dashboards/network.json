{
  "uid": "uptime-network",
  "title": "Uptime - Network",
  "description": "The fabric inside the building. What every host NIC is carrying, how much of it goes to the internet against how much stays east-west, the trunks between zones, and the cable fleet.",
  "tags": ["uptime"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["uptime"],
      "targetBlank": false,
      "title": "Uptime",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "uptime-prom" },
        "enable": true,
        "expr": "uptime_trunk_up == 0",
        "hide": false,
        "iconColor": "red",
        "name": "Trunk down",
        "step": "10s",
        "textFormat": "{{a}} to {{b}}",
        "titleFormat": "Trunk down"
      },
      {
        "datasource": { "type": "prometheus", "uid": "uptime-prom" },
        "enable": true,
        "expr": "uptime_cables_failed > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Cable failed",
        "step": "10s",
        "textFormat": "{{value}} failed",
        "titleFormat": "Cable"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fabric total",
      "description": "Every host's NIC egress plus ingress. Both planes go through a NIC, so this is the total the fabric carries. It is smoothed, so it lags the instantaneous sum.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "super-light-blue" },
          "mappings": [],
          "unit": "bps",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "(uptime_fabric_egress_gbps + uptime_fabric_ingress_gbps) * 1e9",
          "legendFormat": "Fabric",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "North-south",
      "description": "What crosses the routers to and from the internet.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "unit": "bps",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_north_south_gbps * 1e9",
          "legendFormat": "North-south",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "East-west",
      "description": "Fabric total minus north-south, which is traffic that never leaves the building: service to service, replication and storage rebalance. The game's own Network page does the same subtraction.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "mappings": [],
          "unit": "bps",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "clamp_min((uptime_fabric_egress_gbps + uptime_fabric_ingress_gbps - uptime_north_south_gbps) * 1e9, 0)",
          "legendFormat": "East-west",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Between zones",
      "description": "Every lane of every inter-zone trunk summed. Cross-zone east-west, replication and egress failover all count; same-fabric traffic never does. Zero on a single-zone site.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "mappings": [],
          "unit": "bps",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_inter_zone_gbps * 1e9",
          "legendFormat": "Inter-zone",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Failed cables",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_cables_failed",
          "legendFormat": "Failed",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Trunks down",
      "description": "A trunk is up when both zones have a live multi-zone router and nothing has cut it.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "count(uptime_trunk_up == 0) or vector(0)",
          "legendFormat": "Down",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "North-south against east-west",
      "description": "Stacked, so the total height is the fabric total. When east-west dominates, growing the internal network helps and growing the uplink does not.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 55,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "bps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "North-south" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "East-west" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_north_south_gbps * 1e9",
          "legendFormat": "North-south",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "clamp_min((uptime_fabric_egress_gbps + uptime_fabric_ingress_gbps - uptime_north_south_gbps) * 1e9, 0)",
          "legendFormat": "East-west",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Fabric in and out",
      "description": "The two directions separately, both summed across every host NIC whatever the host's state.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "bps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_fabric_egress_gbps * 1e9",
          "legendFormat": "NIC egress",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_fabric_ingress_gbps * 1e9",
          "legendFormat": "NIC ingress",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Inter-zone trunk state",
      "description": "One row per zone pair. Empty on a single-zone site, which has no trunks.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "fillOpacity": 80,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "index": 1, "text": "Down" },
                "1": { "color": "green", "index": 0, "text": "Up" }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "alignValue": "center",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "auto",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_trunk_up",
          "legendFormat": "{{a}} - {{b}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Inter-zone trunk lanes",
      "description": "One trunk per zone pair, a lane each way, labelled by the zone traffic leaves and the zone it enters. Both border routers carry it, so a busy lane is load on two fabrics.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "bps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_trunk_lane_gbps * 1e9",
          "legendFormat": "{{from}} to {{to}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Drops inside the building",
      "description": "Backbone is the worst inter-zone trunk lane. Appliance fabric is what the in-path security appliances are shedding. The Internet dashboard carries the site's own uplink drops.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_drop_probability{stage=~\"backbone|appliance_fabric\"}",
          "legendFormat": "{{stage}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "table",
      "title": "Trunk lane drop, worst first",
      "description": "What a saturated lane is shedding from everything that crosses it. No rows on a single-zone site.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Drop" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 3 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.001 },
                    { "color": "red", "value": 0.02 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Drop" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "uptime-prom" },
          "editorMode": "code",
          "expr": "uptime_trunk_lane_drop_probability",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "monitor": true,
              "world": true
            },
            "includeByName": {},
            "indexByName": {},
            "renameByName": { "Value": "Drop", "from": "Leaves", "to": "Enters" }
          }
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Cable fleet",
      "description": "Every cable in the world against the ones that are failed right now. A failed cable is a link that is down with both ends still seated.",
      "datasource": { "type": "prometheus", "uid": "uptime-prom" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Installed" },
            "properties": [
